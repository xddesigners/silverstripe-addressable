{
    "name": "xddesigners/silverstripe-addressable",
    "description": "Address fields, geocoding (Google, Mapbox) and an address map for Silverstripe CMS 6 DataObjects. Maintained continuation of symbiote/silverstripe-addressable (same Symbiote\\Addressable namespace, drop-in replacement).",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "addressable",
        "address",
        "geocoding",
        "map"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Remy Vaartjes",
            "email": "remy@xd.nl",
            "role": "Maintainer"
        },
        {
            "name": "Symbiote",
            "homepage": "https://www.symbiote.com.au/",
            "role": "Original author"
        },
        {
            "name": "Marcus Nyeholt",
            "email": "nyeholt@symbiote.com.au",
            "role": "Original author"
        }
    ],
    "support": {
        "issues": "https://github.com/xddesigners/silverstripe-addressable/issues",
        "source": "https://github.com/xddesigners/silverstripe-addressable"
    },
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "guzzlehttp/guzzle": "^7"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^4",
        "silverstripe/cms": "^6",
        "silverstripe/sqlite3": "^4",
        "squizlabs/php_codesniffer": "^3.5"
    },
    "replace": {
        "symbiote/silverstripe-addressable": "*",
        "ajshort/silverstripe-addressable": "self.version",
        "silverstripe-australia/addressable": "self.version"
    },
    "scripts": {
        "phpcbf": "phpcbf src/ src/ tests/",
        "phpcs": "phpcs src/ src/ tests/"
    },
    "autoload": {
        "psr-4": {
            "Symbiote\\Addressable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symbiote\\Addressable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
